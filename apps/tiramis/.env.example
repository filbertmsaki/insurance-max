# =========================
# TIRAMIS local/development configuration
# =========================
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=9091
APP_GLOBAL_PREFIX=api
APP_URL=http://localhost:9091
TIRA_ENV=uat

# DATABASE
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace-with-database-password
DB_DATABASE=tiramis_db
DB_SSL=false

# SECURITY
TIRAMIS_SECRET_ENCRYPTION_KEY=replace-with-32-byte-base64-key
TIRAMIS_SECRET_ENCRYPTION_KEY_PREVIOUS=
TIRAMIS_TRUSTED_PROXY_IPS=127.0.0.1,::1
PORTAL_ADMIN_JWT_ACCESS_SECRET=replace-with-portal-JWT-ACCESS-SECRET
PORTAL_ADMIN_JWT_ISSUER=insurance-idp.tz
PORTAL_ADMIN_JWT_AUDIENCE=insurance-platform
PORTAL_ADMIN_SESSION_VALIDATION_ENABLED=false
PORTAL_ADMIN_SESSION_INTROSPECTION_URL=
PORTAL_ADMIN_REQUIRED_PERMISSIONS=
PORTAL_ADMIN_MFA_MAX_AGE_MINUTES=0
PORTAL_ADMIN_RATE_LIMIT_MAX=60
PORTAL_ADMIN_RATE_LIMIT_WINDOW_MS=60000
TIRAMIS_LEGACY_RAW_API_KEYS_ENABLED=true

# TIRA CERTIFICATES AND ENDPOINTS
# Runtime TIRA URLs/secrets/certificates are read from env, not persisted to DB.
TIRAMIS_CERTIFICATE_BASE_DIR=apps/tiramis/src/assets/certificaties
TIRAMIS_CERTIFICATE_EXPIRY_WARNING_DAYS=30
# TIRA system identity for this server's TIRA_ENV.
TIRA_CLIENT_CODE=replace-with-tira-client-code
TIRA_CLIENT_KEY=replace-with-client-key
TIRA_SYSTEM_CODE=replace-with-tira-system-code
TIRA_SYSTEM_NAME=replace-with-tira-system-name
TIRA_CLIENT_CERT_PASSWORD=replace-with-certificate-password
TIRA_PUBLIC_CERT_PASSWORD=replace-with-public-certificate-password
TIRAMIS_BASE_URL=https://uat-tira.example.com
# true accepts expired TIRA certificates (with a warning); keep false in production.
TIRA_ALLOW_EXPIRED_CERTIFICATES=false
TIRA_SIGNATURE_ALGORITHM=sha1WithRSAEncryption

# TIRA HTTP AND REQUEST LOGGING
TIRAMIS_HTTP_TIMEOUT_MS=60000
TIRAMIS_LOG_PAYLOADS=false
TIRAMIS_REQUEST_LOG_ENABLED=true
TIRAMIS_REQUEST_LOG_REDACT_XML=true
TIRAMIS_REQUEST_LOG_REDACTED_XML_TAGS=
TIRAMIS_REQUEST_LOG_DIR=./logs/tira-requests
TIRAMIS_CALLBACK_ERROR_LOG_DIR=./logs

# CALLBACK PROCESSING AND RETENTION
TIRAMIS_CALLBACK_DEAD_LETTER_RAW_XML_MODE=redacted
TIRAMIS_CALLBACK_DIAGNOSTICS_RETENTION_ENABLED=true
TIRAMIS_CALLBACK_DIAGNOSTICS_RETENTION_DAYS=180
TIRAMIS_INTERNAL_CALLBACK_TESTS_ENABLED=false

# TIRA SUBMISSION RETRIES
TIRAMIS_RETRY_ENABLED=true
TIRAMIS_RETRY_BATCH_SIZE=20
TIRAMIS_RETRY_MAX_ATTEMPTS=5
TIRAMIS_RETRY_BASE_DELAY_SECONDS=60
TIRAMIS_RETRY_MAX_DELAY_SECONDS=900
TIRAMIS_FINAL_CALLBACK_TIMEOUT_MINUTES=30

# PORTAL NOTIFICATIONS AND OUTBOX
TIRAMIS_PORTAL_NOTIFY_ENABLED=true
INSURANCE_PORTAL_WEBHOOK_TIMEOUT_MS=5000
TIRAMIS_PORTAL_WEBHOOK_MAX_ATTEMPTS=8
TIRAMIS_PORTAL_WEBHOOK_RETRY_DELAYS_SECONDS=5,15,30,60,300,900,1800,3600
TIRAMIS_PORTAL_WEBHOOK_ALLOWED_HOSTS=
TIRAMIS_PORTAL_WEBHOOK_REQUIRE_HTTPS=false
TIRAMIS_PORTAL_WEBHOOK_BLOCK_PRIVATE_IPS=false
TIRAMIS_PORTAL_WEBHOOK_SIGNING_SECRET=
TIRAMIS_PORTAL_OUTBOX_BATCH_SIZE=20
TIRAMIS_PORTAL_OUTBOX_INTERVAL_MS=10000
