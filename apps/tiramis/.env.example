# =========================
# APP CONFIG
# =========================
APP_NAME=Alliance Platform
APP_ENV=development
APP_PORT=3000
APP_GLOBAL_PREFIX=api
APP_VERSION=v1
APP_TIMEZONE=Africa/Dar_es_Salaam

# =========================
# DATABASE CONFIG
# Supported: postgres, mysql, oracle
# =========================
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=alliance_db

# Oracle optional
DB_ORACLE_CONNECT_STRING=localhost:1521/ORCLPDB1

DB_SYNCHRONIZE=false
DB_LOGGING=true
DB_SSL=false

# =========================
# CACHE CONFIG
# =========================
CACHE_ENABLED=true
CACHE_STORE=memory
CACHE_TTL=60
CACHE_MAX=1000

# =========================
# CORS CONFIG
# =========================
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:3000,http://localhost:4200,http://localhost:5173
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
CORS_CREDENTIALS=true

# =========================
# LOGGER CONFIG
# =========================
LOGGER_ENABLED=true
LOGGER_LEVEL=log,error,warn,debug,verbose
LOGGER_PRETTY=true

# =========================
# MAIL CONFIG
# =========================
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=no-reply@example.com
MAIL_PASSWORD=password
MAIL_FROM_NAME=Alliance System
MAIL_FROM_EMAIL=no-reply@example.com

# =========================
# QUEUE CONFIG
# BullMQ uses Redis
# =========================
QUEUE_ENABLED=true
QUEUE_PREFIX=alliance
QUEUE_DEFAULT_JOB_ATTEMPTS=3
QUEUE_DEFAULT_JOB_DELAY=0
QUEUE_REMOVE_ON_COMPLETE=true
QUEUE_REMOVE_ON_FAIL=false

# =========================
# REDIS CONFIG
# Used for cache, queue, and microservice transport
# =========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=alliance:
REDIS_RETRY_ATTEMPTS=5
REDIS_RETRY_DELAY=3000

# =========================
# MICROSERVICE TRANSPORT
# =========================
TCP_HOST=0.0.0.0
TCP_PORT=4001
