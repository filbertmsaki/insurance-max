# =========================
# APP CONFIG
# =========================
APP_NAME=TIRAMIS Service
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=9090
APP_GLOBAL_PREFIX=api
APP_VERSION=v1
APP_URL=https://api.example.com/tiramis-api
TIRAMIS_TARGET_ENV=live

# =========================
# DATABASE
# Supported: postgres, mysql, oracle
# =========================
DB_TYPE=postgres
DB_HOST=replace-with-live-db-host
DB_PORT=5432
DB_USERNAME=replace-with-live-db-user
DB_PASSWORD=replace-with-live-db-password
DB_DATABASE=tiramis_db
DB_NAME=tiramis_db
DB_SCHEMA=public

# Oracle optional
DB_ORACLE_CONNECT_STRING=

DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=true

# =========================
# LOGGING
# =========================
LOGGER_ENABLED=true
LOGGER_LEVEL=log,error,warn

# =========================
# SECURITY AND CERTIFICATES
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this key stable after seeding encrypted TIRAMIS secrets.
# =========================
TIRAMIS_SECRET_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# Old key(s), comma separated, still accepted for decryption during a key rotation.
TIRAMIS_SECRET_ENCRYPTION_KEY_PREVIOUS=
TIRAMIS_TRUSTED_PROXY_IPS=127.0.0.1,::1
PORTAL_ADMIN_JWT_ACCESS_SECRET=replace-with-portal-JWT-ACCESS-SECRET
PORTAL_ADMIN_JWT_ISSUER=insurance-idp.tz
PORTAL_ADMIN_JWT_AUDIENCE=insurance-platform
TIRAMIS_CERTIFICATE_BASE_DIR=/opt/apps/tiramis/certificates
TIRAMIS_CERTIFICATE_EXPIRY_WARNING_DAYS=30

# Expected certificate files:
ALLIANCE_TIRA_CLIENT_KEY_TEST=replace-with-test-client-key
ALLIANCE_CLIENT_PRIVATE_CERT_PASSWORD_TEST=replace-with-test-certificate-password
TIRA_PUBLIC_CERT_PASSWORD_TEST=replace-with-test-public-certificate-password
TIRAMIS_TEST_BASE_URL=https://test-tira.example.com
TIRAMIS_TEST_CALLBACK_URL=https://tiramis.your-domain.example/api/tiramis/callbacks/test

ALLIANCE_TIRA_CLIENT_KEY_LIVE=replace-with-live-client-key
ALLIANCE_CLIENT_PRIVATE_CERT_PASSWORD_LIVE=replace-with-live-certificate-password
TIRA_PUBLIC_CERT_PASSWORD_LIVE=replace-with-live-public-certificate-password
TIRAMIS_LIVE_BASE_URL=https://live-tira.example.com
TIRAMIS_LIVE_CALLBACK_URL=https://tiramis.your-domain.example/api/tiramis/callbacks/live

# =========================
# INTERNAL TRANSPORT
# =========================
TIRAMIS_TCP_HOST=0.0.0.0
TIRAMIS_TCP_PORT=4001

# =========================
# PORTAL NOTIFICATIONS
# =========================
TIRAMIS_PORTAL_NOTIFY_ENABLED=true
INSURANCE_PORTAL_WEBHOOK_TIMEOUT_MS=5000

# =========================
# RETRY SCHEDULER
# =========================
TIRAMIS_RETRY_ENABLED=true
TIRAMIS_INTERNAL_CALLBACK_TESTS_ENABLED=false
TIRAMIS_RETRY_BATCH_SIZE=20
TIRAMIS_RETRY_MAX_ATTEMPTS=5
TIRAMIS_RETRY_BASE_DELAY_SECONDS=60
TIRAMIS_RETRY_MAX_DELAY_SECONDS=900
TIRAMIS_FINAL_CALLBACK_TIMEOUT_MINUTES=30

# =========================
# EXTERNAL TIRA HTTP
# =========================
TIRAMIS_HTTP_TIMEOUT_MS=60000
TIRAMIS_LOG_PAYLOADS=false
TIRAMIS_REQUEST_LOG_ENABLED=true
TIRAMIS_REQUEST_LOG_DIR=/opt/apps/tiramis/shared/tira-requests

# Persists tiramis_callback_error.log across deploys — see deploy/tiramis/PRODUCTION_ENV.md
TIRAMIS_CALLBACK_ERROR_LOG_DIR=/opt/apps/tiramis/shared

# =========================
# RUNTIME / PORTAL OUTBOX (added)
# =========================
NODE_ENV=production
API_DEBUG_ERRORS_ENABLED=false
SLOW_REQUEST_THRESHOLD_MS=2000
TIRAMIS_PORTAL_WEBHOOK_MAX_ATTEMPTS=8
TIRAMIS_PORTAL_OUTBOX_BATCH_SIZE=20
TIRAMIS_PORTAL_OUTBOX_INTERVAL_MS=10000
