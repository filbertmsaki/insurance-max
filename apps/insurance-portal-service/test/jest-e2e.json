{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "globalSetup": "<rootDir>/support/global-setup.ts",
  "globalTeardown": "<rootDir>/support/global-teardown.ts",
  "setupFilesAfterEnv": ["<rootDir>/support/spec-database.ts"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@insurance-max/contracts$": "<rootDir>/../../../libs/contracts/src",
    "^@insurance-max/observability$": "<rootDir>/../../../libs/observability/src",
    "^@insurance-max/portal-shared$": "<rootDir>/../../../libs/portal-shared/src",
    "^@insurance-max/portal-shared/(.*)$": "<rootDir>/../../../libs/portal-shared/src/$1",
    "^@insurance-max/persistence$": "<rootDir>/../../../libs/persistence/src",
    "^@insurance-max/shared-config$": "<rootDir>/../../../libs/shared-config/src",
    "^@insurance-max/shared-kernel$": "<rootDir>/../../../libs/shared-kernel/src",
    "^otplib$": "<rootDir>/../../../test/mocks/otplib.ts"
  }
}
