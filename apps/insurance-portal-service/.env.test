# Overrides applied when NODE_ENV=test (Jest sets it automatically).
#
# Precedence: real environment variables > this file > .env. Connection
# settings (DB_HOST, DB_PORT, DB_USERNAME, DB_PASSWORD) and secrets come from
# .env, so they are not duplicated here. Never put secrets in this file.
#
# DB_DATABASE is intentionally absent: the e2e global setup creates a
# disposable insurance_portal_test_<run> database per run, gives each spec
# file its own copy, and drops them all afterwards. The suite refuses to
# connect to any database that does not follow that naming scheme.
APP_ENV=test
DB_SYNCHRONIZE=false
DB_LOGGING=false
ENABLE_DEMO_SEED=false

# No outbound traffic or background jobs during tests.
MAIL_ENABLED=false
TIRAMIS_STATUS_SYNC_ENABLED=false
TIRAMIS_RETRY_ENABLED=false
TIRAMIS_NOTIFICATION_ENABLED=false

# Optional knobs for the test database tooling:
# TEST_DB_ALLOWED_HOSTS=   extra DB_HOST values allowed besides localhost
# TEST_DB_STALE_HOURS=2    age after which abandoned test databases are dropped
# KEEP_TEST_DB=true        keep this run's databases for debugging
