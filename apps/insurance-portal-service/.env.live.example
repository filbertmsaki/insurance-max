# Production environment template for insurance-portal-service.
# Copy to the server as /opt/apps/insurance-max/prod/backend/shared/.env
# (deploy/backend/deploy.sh symlinks it into each release), fill in every
# "replace-with-..." placeholder and generate every secret, then:
#   chmod 600 .env
# Do not commit a real production .env file.
# deploy/backend/shared.env.example is an exact copy of this file; keep them
# identical. Full walkthrough: docs/DEPLOYMENT_GUIDE.md.
#
# Values below are grouped and ordered to match
# src/config/env.validation.ts — every var Joi validates is listed here,
# even ones that just keep their safe default, so nothing is silently
# missing on a fresh production box.

# =========================
# APP CONFIG
# =========================
APP_NAME=Insurance Portal Service
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=9090
APP_GLOBAL_PREFIX=api
APP_VERSION=v1
APP_TIMEZONE=Africa/Dar_es_Salaam
# Public origin of this API, WITHOUT a trailing /api: the app appends
# /api/v1 itself (e.g. the TIRAMIS webhook URL becomes
# APP_URL/api/v1/webhooks/tiramis/notifications).
APP_URL=https://replace-with-production-api-domain
APP_FRONTEND_URL=https://replace-with-production-frontend-domain
SUPPORT_EMAIL=support@insurance-idp.tz
# Swagger must stay off in production — it exposes API schema/routes publicly.
SWAGGER_ENABLED=false
# Disabled by default. When true, internal error messages are returned to every caller.
API_DEBUG_ERRORS_ENABLED=false

# Populated automatically by the CI/release pipeline — do not set by hand.
APP_RELEASE_SHA=
APP_RELEASE_VERSION=
APP_BUILT_AT=
RELEASE_EVIDENCE_FILE=.release/release-gate.json
RELEASE_EVIDENCE_MAX_AGE_HOURS=168
RELEASE_BUILD_LINT_PASSED=false
RELEASE_BUILD_UNIT_TESTS_PASSED=false
RELEASE_BUILD_INTEGRATION_TESTS_PASSED=false
RELEASE_BUILD_E2E_TESTS_PASSED=false
RELEASE_SECURITY_CRITICAL_FINDINGS=0
RELEASE_SECURITY_TENANT_ISOLATION_PASSED=false
RELEASE_SECURITY_SECRETS_SCAN_PASSED=false
RELEASE_SECURITY_AUTHORIZATION_PASSED=false
RELEASE_OPERATIONS_BACKUP_VERIFIED=false
RELEASE_OPERATIONS_RESTORE_VERIFIED=false
RELEASE_OPERATIONS_ROLLBACK_VERIFIED=false
RELEASE_APPROVALS_UAT_APPROVED=false
RELEASE_APPROVALS_TECHNICAL_APPROVED=false
RELEASE_APPROVALS_BUSINESS_APPROVED=false

# =========================
# DATABASE CONFIG
# Supported: postgres, mysql, oracle
# =========================
DB_TYPE=postgres
DB_HOST=replace-with-live-db-host
DB_PORT=5432
DB_USERNAME=replace-with-live-db-user
DB_PASSWORD=replace-with-live-db-password
DB_DATABASE=insurance_portal_db
DB_NAME=insurance_portal_db
DB_SCHEMA=public
DB_ORACLE_CONNECT_STRING=
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=true

# =========================
# CACHE CONFIG
# Switch to redis if running more than one instance behind a load balancer.
# =========================
CACHE_ENABLED=true
CACHE_STORE=memory
CACHE_TTL=60
CACHE_MAX=1000

# =========================
# DASHBOARD
# =========================
DASHBOARD_CACHE_ENABLED=true
DASHBOARD_CACHE_TTL_SECONDS=60
DASHBOARD_MAX_RANGE_DAYS=366

# =========================
# SAAS BILLING
# =========================
SAAS_BILLING_CRON=0 30 1 * * *
SAAS_INVOICE_DUE_DAYS=14
SAAS_PAST_DUE_GRACE_DAYS=7
SAAS_DUNNING_CRON=0 15 1 * * *
SAAS_AUTO_SUSPEND_ENABLED=true
SAAS_AUTO_RESTORE_AFTER_PAYMENT=true

# =========================
# API KEYS (tenant-facing integration keys)
# =========================
API_KEYS_ENABLED=true
API_KEY_REQUIRE_IP_ALLOWLIST=true
API_KEY_MAX_IPS_PER_KEY=1
API_KEY_DEFAULT_RATE_LIMIT_PER_MINUTE=60
API_KEY_ROTATION_GRACE_HOURS=24
API_KEY_MAX_VALIDITY_DAYS=365

# =========================
# SECURITY
# Generate with: openssl rand -base64 32
# =========================
SECURITY_STEP_UP_MAX_AGE_MINUTES=10
SECURITY_AUDIT_HASH_CHAIN_ENABLED=true
SECURITY_REQUIRE_2FA_FOR_ALL_USERS=false
SECURITY_REQUIRE_2FA_ROLES=
SECURITY_REQUIRE_2FA_PERMISSIONS=
SECURITY_REQUIRE_2FA_USER_TYPES=

# =========================
# SESSION
# =========================
SESSION_IDLE_MINUTES=1440
SESSION_ABSOLUTE_HOURS=24
SESSION_REFRESH_REUSE_DETECTION=true

# =========================
# AUDIT
# =========================
AUDIT_HASH_CHAIN_ENABLED=true

# =========================
# DATA RETENTION
# =========================
DATA_RETENTION_ENABLED=true
# Flip to false only after the retention job has been verified against a
# production snapshot — a dry run misfire is far safer than a bad delete.
DATA_RETENTION_DRY_RUN_DEFAULT=true

# =========================
# OBSERVABILITY / NETWORKING
# =========================
OBSERVABILITY_ENABLED=true
METRICS_ENABLED=true
TRACING_ENABLED=true
# Must stay false — health details (DB/redis/queue internals) should never
# be exposed on a public endpoint.
HEALTH_DETAILS_PUBLIC=false
SLOW_REQUEST_THRESHOLD_MS=2000
# true when the app sits behind nginx/Apache/a load balancer (it does in prod).
TRUST_PROXY_ENABLED=true
TRUST_PROXY_HOPS=1

# =========================
# CORS CONFIG
# =========================
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=https://replace-with-production-frontend-domain
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS
CORS_CREDENTIALS=true

# =========================
# LOGGER CONFIG
# error,warn only — keeps 5xx/4xx visibility without per-request noise.
# =========================
LOGGER_ENABLED=true
LOGGER_LEVEL=error,warn

# =========================
# MAIL CONFIG
# =========================
MAIL_ENABLED=true
MAIL_HOST=replace-with-smtp-host
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=replace-with-smtp-user
MAIL_PASSWORD=replace-with-smtp-password
MAIL_FROM_NAME=Insurance Portal
MAIL_FROM_EMAIL=no-reply@insurance-idp.tz

# =========================
# QUEUE CONFIG
# =========================
QUEUE_ENABLED=true

# =========================
# REDIS CONFIG
# Backs OTP/session storage regardless of CACHE_STORE — required, not optional.
# =========================
REDIS_HOST=replace-with-live-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-live-redis-password
REDIS_DB=0
REDIS_ALLOW_IN_MEMORY_FALLBACK=false

# =========================
# ANALYTICS
# =========================
ANALYTICS_ENABLED=true
ANALYTICS_PROJECTION_BATCH_SIZE=100
ANALYTICS_PROJECTION_MAX_ATTEMPTS=8
ANALYTICS_CURRENT_LAG_SECONDS=300
ANALYTICS_STALE_LAG_SECONDS=3600

# =========================
# JWT / SECURITY
# Generate each with: openssl rand -base64 32 (or any string >= 32 chars).
# Required in production — the app will refuse to boot without them, and
# also refuses the template values below (APP_ENV=production).
# =========================
JWT_ACCESS_SECRET=replace-with-at-least-32-character-secret
JWT_REFRESH_SECRET=replace-with-at-least-32-character-secret
JWT_RESET_SECRET=replace-with-at-least-32-character-secret
JWT_ACCESS_EXPIRATION=1d
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=insurance-idp.tz
JWT_AUDIENCE=insurance-platform

# =========================
# AUTHENTICATION SECURITY
# =========================
JWT_2FA_SECRET=replace-with-another-unique-32-character-secret
JWT_2FA_EXPIRATION=5m
AUTH_2FA_MAX_ATTEMPTS=5
AUTH_TRUSTED_DEVICE_DAYS=30
AUTH_ALLOW_TRUSTED_DEVICE_BYPASS=true

# Generate using: openssl rand -base64 32
# The sample below is a placeholder and is rejected when APP_ENV=production.
AUTH_SECRET_ENCRYPTION_KEY=UkVQTEFDRS1CRUZPUkUtREVQTE9ZLTMyQllURS1LRVk=
AUTH_BACKUP_CODE_PEPPER=replace-with-at-least-32-random-characters
AUTH_DEVICE_TOKEN_PEPPER=replace-with-at-least-32-random-characters

ENABLE_EMAIL_VERIFICATION=true
EMAIL_VERIFICATION_EXPIRY_HOURS=24
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
SMS_PROVIDER=beem
# Credentials for the NextSMS provider; leave blank when another provider is used.
NEXTSMS_USERNAME=
NEXTSMS_PASSWORD=
NEXTSMS_SENDER_ID=INFO
NEXTSMS_ENDPOINT=https://messaging.nextsms.co.tz/api/sms/v1/text/single
BEEM_ENDPOINT=https://apisms.beem.africa/v1/send
AT_LIVE_ENDPOINT=https://api.africastalking.com
AT_SANDBOX_ENDPOINT=https://api.sandbox.africastalking.com

# =========================
# THROTTLING
# =========================
THROTTLER_TTL=60000
THROTTLER_LIMIT=100

# =========================
# TIRAMIS HTTP CLIENT
# =========================
# Public base of the TIRAMIS service, WITHOUT /api (the client appends
# /api/tiramis/... itself). Include any reverse-proxy prefix such as /tiramis-api.
TIRAMIS_SERVICE_BASE_URL=https://api.example.com/tiramis-api
# IP TIRAMIS calls the portal webhook from (the webhook API key is allowlisted
# to it). Required here because TIRAMIS_SERVICE_BASE_URL uses a hostname.
TIRAMIS_WEBHOOK_SOURCE_IP=replace-with-tiramis-server-ip
TIRAMIS_TARGET_ENV=live
TIRAMIS_HTTP_TIMEOUT_MS=60000
TIRAMIS_SOURCE_SERVICE=insurance-portal-service
# Dedicated encryption key for TIRAMIS service API keys stored in
# tiramis_company_configurations. Keep this separate from JWT signing keys.
TIRAMIS_SERVICE_API_KEY_ENCRYPTION_KEY=replace-with-at-least-32-character-secret
# =========================
# TIRAMIS STATUS SYNC
# =========================
TIRAMIS_STATUS_SYNC_ENABLED=true
TIRAMIS_STATUS_SYNC_CRON=*/2 * * * *
TIRAMIS_STATUS_SYNC_LIMIT=50
TIRAMIS_STATUS_SYNC_INCLUDE_PAYLOAD=true
TIRAMIS_STATUS_SYNC_MAX_AGE_HOURS=72
TIRAMIS_CALLBACK_OVERDUE_MINUTES=10

# =========================
# TIRAMIS PORTAL EVENT OUTBOX / RECONCILIATION
# =========================

# =========================
# TIRAMIS RETRY
# =========================
TIRAMIS_RETRY_ENABLED=true
TIRAMIS_RETRY_CRON=*/3 * * * *
TIRAMIS_RETRY_LIMIT=20
TIRAMIS_RETRY_MAX_ATTEMPTS=5
TIRAMIS_RETRY_BASE_DELAY_SECONDS=60
TIRAMIS_RETRY_LOCK_MINUTES=5
TIRAMIS_RETRY_MAX_DELAY_MINUTES=30

# =========================
# TIRAMIS AUDIT
# =========================
TIRAMIS_AUDIT_ENABLED=true
TIRAMIS_AUDIT_STORE_PAYLOAD_SNAPSHOT=false
TIRAMIS_AUDIT_MAX_METADATA_SIZE=20000

# =========================
# TIRAMIS NOTIFICATIONS
# =========================
TIRAMIS_NOTIFICATION_ENABLED=true
TIRAMIS_NOTIFICATION_WEBHOOK_ENABLED=false
TIRAMIS_NOTIFICATION_WEBHOOK_URL=
TIRAMIS_NOTIFICATION_WEBHOOK_TOKEN=
TIRAMIS_NOTIFICATION_DEDUPE_MINUTES=30
TIRAMIS_NOTIFICATION_MAX_METADATA_SIZE=20000
TIRAMIS_NOTIFICATION_NOTIFY_FINAL_SUCCESS=false
TIRAMIS_NOTIFICATION_NOTIFY_BUSINESS_SYNC_SUCCESS=false

# =========================
# REGULATORY COMPLIANCE
# =========================
REGULATORY_DEFAULT_TIMEZONE=Africa/Dar_es_Salaam
REGULATORY_RECONCILIATION_TOLERANCE=0.01
REGULATORY_REQUIRE_SUBMISSION_EVIDENCE=true
PREMIUM_LEVY_DEFAULT_RATE=1.5
PREMIUM_LEVY_REQUIRE_ADJUSTMENT_EVIDENCE=true

# =========================
# REPORTING
# =========================
REPORTING_DEFAULT_MAX_ROWS=100000
REPORTING_DEFAULT_RETENTION_DAYS=90
REPORTS_ARTIFACT_RETENTION_DAYS=30
REPORTS_REQUIRE_MAIL_VERIFICATION=true
REPORTS_MAX_ROWS=200000
REPORTS_DEFAULT_TIMEZONE=Africa/Dar_es_Salaam

# =========================
# DOCUMENTS
# =========================
DOCUMENT_STORAGE_ROOT=/opt/apps/insurance-portal-service/shared/uploads/documents
DOCUMENT_DEFAULT_MAX_BYTES=10485760
DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png


# =========================
# CUSTOMER / INTERMEDIARY PORTAL
# =========================
PORTAL_INVITATION_EXPIRY_HOURS=48
PORTAL_SESSION_IDLE_MINUTES=1440
PORTAL_UPLOAD_ROOT=/opt/apps/insurance-portal-service/shared/uploads
PORTAL_UPLOAD_MAX_BYTES=10485760
PORTAL_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png

# =========================
# FINANCE
# =========================
FINANCE_AUTO_RECEIPT_PROVIDER_PAYMENTS=true
FINANCE_AUTO_ALLOCATE_EXACT_INVOICE_REFERENCE=true
FINANCE_RECONCILIATION_AUTO_MATCH_SCORE=90
FINANCE_OUTBOX_ENABLED=true
FINANCE_OUTBOX_CRON=*/1 * * * *
FINANCE_OUTBOX_BATCH_SIZE=100
FINANCE_OUTBOX_MAX_ATTEMPTS=10

# =========================
# RUNTIME (added)
# =========================
NODE_ENV=production
# Optional; used by token blacklist when Redis is enabled
# REDIS_URL=redis://localhost:6379

# =========================
# SMS PROVIDERS (added)
# =========================
AT_USERNAME=sandbox
AT_API_KEY=replace-with-africastalking-api-key
AT_SENDER_ID=
BEEM_API_KEY=replace-with-beem-api-key
BEEM_SECRET_KEY=replace-with-beem-secret-key

# =========================
# DOCUMENTS / MALWARE SCAN / SIGNATURES (added)
# =========================
DOCUMENT_MALWARE_SCAN_MODE=clamav
DOCUMENT_MALWARE_SCAN_FAIL_OPEN=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
# DOCUMENT_STORAGE_BUCKET=
# Falls back to JWT_SECRET, then AUTH_JWT_SECRET
SIGNATURE_EVIDENCE_SECRET=replace-with-signature-evidence-secret
# JWT_SECRET=
# AUTH_JWT_SECRET=

# =========================
# SCHEDULES / RENEWALS / RETENTION (added)
# =========================
COMPLAINT_SLA_CRON=*/15 * * * *
RENEWAL_ELIGIBILITY_CRON=0 1 * * *
RENEWAL_WINDOW_BEFORE_DAYS=7
RENEWAL_WINDOW_AFTER_DAYS=7
RENEWAL_OFFER_VALID_DAYS=30
SAAS_SCHEDULED_CHANGES_CRON=0 */15 * * * *
DATA_RETENTION_ENFORCEMENT_LIMIT=500
REPORTING_DEFAULT_TIMEZONE=Africa/Dar_es_Salaam
REPORTING_REQUIRE_MAIL_VERIFICATION=true

# =========================
# TIRAMIS (added)
# =========================
TIRAMIS_CANONICAL_INGRESS_ENABLED=false

# =========================
# SEEDER ONLY (added) - not read at runtime
# =========================
# TIRAMIS_REFERENCE_DATA_DIR=./data/tiramis-reference
# SEED_TARGET_COMPANY_CODE=ICC110
# SEED_ALLOW_REFERENCE_CORRECTION=false
# DEFAULT_COMPANY_NAME=replace-with-company-name
ENABLE_DEMO_SEED=false
# INITIAL_OWNER_EMAIL=replace-with-email
# INITIAL_OWNER_FIRST_NAME=replace-with-first-name
# INITIAL_OWNER_LAST_NAME=replace-with-last-name
# INITIAL_OWNER_PASSWORD=replace-with-strong-password
# INITIAL_OWNER_PHONE=replace-with-phone
# INITIAL_OWNER_USER_NO=replace-with-user-no
# INITIAL_COMPANY_ADMIN_EMAIL=replace-with-email
# INITIAL_COMPANY_ADMIN_FIRST_NAME=replace-with-first-name
# INITIAL_COMPANY_ADMIN_LAST_NAME=replace-with-last-name
# INITIAL_COMPANY_ADMIN_PASSWORD=replace-with-strong-password
# INITIAL_COMPANY_ADMIN_PHONE=replace-with-phone
# INITIAL_COMPANY_ADMIN_USER_NO=replace-with-user-no
# INITIAL_COMPANY_USER_EMAIL=replace-with-email
# INITIAL_COMPANY_USER_FIRST_NAME=replace-with-first-name
# INITIAL_COMPANY_USER_LAST_NAME=replace-with-last-name
# INITIAL_COMPANY_USER_PASSWORD=replace-with-strong-password
# INITIAL_COMPANY_USER_PHONE=replace-with-phone
# INITIAL_COMPANY_USER_USER_NO=replace-with-user-no
# Admin login for: npm run tiramis:sync-webhook-keys
# TIRAMIS_ADMIN_EMAIL=replace-with-email
# TIRAMIS_ADMIN_PASSWORD=replace-with-password
# Demo/test intermediary users
# INTERMEDIARY_PORTAL_ADMIN_PASSWORD=replace-with-strong-password
# INTERMEDIARY_PORTAL_USER_PASSWORD=replace-with-strong-password
# SEED_BROKER_ADMIN_EMAIL=replace-with-email
# SEED_BROKER_ADMIN_PASSWORD=replace-with-strong-password
# SEED_BROKER_ADMIN_PHONE=replace-with-phone
# SEED_BROKER_ADMIN_USER_NO=replace-with-user-no
# SEED_BROKER_USER_EMAIL=replace-with-email
# SEED_BROKER_USER_PASSWORD=replace-with-strong-password
# SEED_BROKER_USER_PHONE=replace-with-phone
# SEED_BROKER_USER_USER_NO=replace-with-user-no
# SEED_AGENCY_ADMIN_EMAIL=replace-with-email
# SEED_AGENCY_ADMIN_PASSWORD=replace-with-strong-password
# SEED_AGENCY_ADMIN_PHONE=replace-with-phone
# SEED_AGENCY_ADMIN_USER_NO=replace-with-user-no
# SEED_AGENCY_USER_EMAIL=replace-with-email
# SEED_AGENCY_USER_PASSWORD=replace-with-strong-password
# SEED_AGENCY_USER_PHONE=replace-with-phone
# SEED_AGENCY_USER_USER_NO=replace-with-user-no

# --- Keys read by the code (added by env audit) ---
ANALYTICS_PROJECTION_STALE_LOCK_MINUTES=10
FINANCE_OUTBOX_LEASE_MINUTES=10
DOCUMENT_STORAGE_PROVIDER=local_private
DOCUMENT_STORAGE_BUCKET=
BEEM_SENDER_NAME=INSURANCE
