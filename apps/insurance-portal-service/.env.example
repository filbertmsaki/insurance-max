# =========================
# APP CONFIG
# =========================
APP_NAME=Insurance Portal Service
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=9090
APP_GLOBAL_PREFIX=api
APP_VERSION=v1
APP_TIMEZONE=Africa/Dar_es_Salaam
APP_URL=http://localhost:9090
APP_FRONTEND_URL=http://localhost:9092
SUPPORT_EMAIL=support@insurance-idp.tz

# =========================
# DATABASE CONFIG
# Supported: postgres, mysql, oracle
# =========================
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=root
DB_DATABASE=insurance_portal_db
DB_SCHEMA=public
DB_ORACLE_CONNECT_STRING=localhost:1521/ORCLPDB1
DB_SYNCHRONIZE=false
DB_LOGGING=true
DB_SSL=false

# =========================
# CACHE CONFIG
# =========================
CACHE_ENABLED=true
CACHE_STORE=memory
CACHE_TTL=60
CACHE_MAX=1000

# =========================
# CORS CONFIG
# =========================
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:3000,http://localhost:4200,http://localhost:5173,http://localhost:9092
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS
CORS_CREDENTIALS=true

# =========================
# LOGGER CONFIG
# =========================
LOGGER_ENABLED=true
LOGGER_LEVEL=log,error,warn,debug,verbose
LOGGER_PRETTY=true

# =========================
# MAIL CONFIG
# =========================
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=no-reply@example.com
MAIL_PASSWORD=password
MAIL_FROM_NAME=Insurance Portal
MAIL_FROM_EMAIL=no-reply@example.com

# =========================
# QUEUE CONFIG
# =========================
QUEUE_ENABLED=true
QUEUE_PREFIX=insurance-portal-service
QUEUE_DEFAULT_JOB_ATTEMPTS=3
QUEUE_DEFAULT_JOB_DELAY=0
QUEUE_REMOVE_ON_COMPLETE=true
QUEUE_REMOVE_ON_FAIL=false

# =========================
# REDIS CONFIG
# =========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=insurance-portal:
REDIS_RETRY_ATTEMPTS=5
REDIS_RETRY_DELAY=3000

# =========================
# JWT / SECURITY
# =========================
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_RESET_SECRET=change-me-reset-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=insurance-idp.tz
JWT_AUDIENCE=insurance-platform
ENABLE_EMAIL_VERIFICATION=true
EMAIL_VERIFICATION_EXPIRY_HOURS=24
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
SMS_PROVIDER=beem

# =========================
# THROTTLING
# =========================
THROTTLER_TTL=60000
THROTTLER_LIMIT=100

# =========================
# MICROSERVICE TRANSPORT
# =========================
TCP_HOST=0.0.0.0
TCP_PORT=4002

# =========================
# TIRAMIS CLIENT
# =========================
TIRAMIS_TCP_HOST=127.0.0.1
TIRAMIS_TCP_PORT=4001
TIRAMIS_TCP_TIMEOUT_MS=60000

# =========================
# TIRAMIS RETRY
# =========================
TIRAMIS_RETRY_ENABLED=true
TIRAMIS_RETRY_LIMIT=20
TIRAMIS_RETRY_MAX_ATTEMPTS=5
TIRAMIS_RETRY_MAX_DELAY_MINUTES=30
TIRAMIS_RETRY_LOCK_TIMEOUT_MINUTES=15
