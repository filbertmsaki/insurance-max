# SEED_AGENCY_ADMIN_PHONE=replace-with-phone
# SEED_AGENCY_ADMIN_USER_NO=replace-with-user-no
# SEED_AGENCY_USER_EMAIL=replace-with-email
# SEED_AGENCY_USER_PASSWORD=replace-with-strong-password
# SEED_AGENCY_USER_PHONE=replace-with-phone
# SEED_AGENCY_USER_USER_NO=replace-with-user-no

# --- Keys read by the code (added by env audit) ---
ANALYTICS_PROJECTION_STALE_LOCK_MINUTES=10
FINANCE_OUTBOX_LEASE_MINUTES=10
DOCUMENT_STORAGE_PROVIDER=local_private
DOCUMENT_STORAGE_BUCKET=
BEEM_SENDER_NAME=INSURANCE
