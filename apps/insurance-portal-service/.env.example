# INITIAL_COMPANY_ADMIN_FIRST_NAME=replace-with-first-name
# INITIAL_COMPANY_ADMIN_LAST_NAME=replace-with-last-name
# INITIAL_COMPANY_ADMIN_PASSWORD=replace-with-strong-password
# INITIAL_COMPANY_ADMIN_PHONE=replace-with-phone
# INITIAL_COMPANY_ADMIN_USER_NO=replace-with-user-no
# INITIAL_COMPANY_USER_EMAIL=replace-with-email
# INITIAL_COMPANY_USER_FIRST_NAME=replace-with-first-name
# INITIAL_COMPANY_USER_LAST_NAME=replace-with-last-name
# INITIAL_COMPANY_USER_PASSWORD=replace-with-strong-password
# INITIAL_COMPANY_USER_PHONE=replace-with-phone
# INITIAL_COMPANY_USER_USER_NO=replace-with-user-no
# Admin login for: npm run tiramis:sync-webhook-keys
