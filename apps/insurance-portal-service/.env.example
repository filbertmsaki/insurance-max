# =========================
# APP CONFIG
# =========================
APP_NAME=Insurance Portal Service
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=9090
APP_GLOBAL_PREFIX=api
APP_VERSION=v1
APP_TIMEZONE=Africa/Dar_es_Salaam
APP_URL=http://localhost:9090
APP_FRONTEND_URL=http://localhost:9092
SUPPORT_EMAIL=support@example.com
APP_RELEASE_SHA=
APP_RELEASE_VERSION=
APP_BUILT_AT=
RELEASE_EVIDENCE_FILE=.release/release-gate.json
RELEASE_EVIDENCE_MAX_AGE_HOURS=168
RELEASE_BUILD_LINT_PASSED=false
RELEASE_BUILD_UNIT_TESTS_PASSED=false
RELEASE_BUILD_INTEGRATION_TESTS_PASSED=false
RELEASE_BUILD_E2E_TESTS_PASSED=false
RELEASE_SECURITY_CRITICAL_FINDINGS=0
RELEASE_SECURITY_TENANT_ISOLATION_PASSED=false
RELEASE_SECURITY_SECRETS_SCAN_PASSED=false
RELEASE_SECURITY_AUTHORIZATION_PASSED=false
RELEASE_OPERATIONS_BACKUP_VERIFIED=false
RELEASE_OPERATIONS_RESTORE_VERIFIED=false
RELEASE_OPERATIONS_ROLLBACK_VERIFIED=false
RELEASE_APPROVALS_UAT_APPROVED=false
RELEASE_APPROVALS_TECHNICAL_APPROVED=false
RELEASE_APPROVALS_BUSINESS_APPROVED=false
SWAGGER_ENABLED=false
# Keep disabled outside short, controlled troubleshooting windows. When true,
# internal error messages are returned to every caller.
API_DEBUG_ERRORS_ENABLED=false

# =========================
# DATABASE CONFIG
# Supported: postgres, mysql, oracle
# =========================
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace-with-database-password
DB_DATABASE=insurance_portal_db
DB_NAME=insurance_portal_db
DB_SCHEMA=public
DB_ORACLE_CONNECT_STRING=localhost:1521/ORCLPDB1
DB_SYNCHRONIZE=false
DB_LOGGING=true
DB_SSL=false

# =========================
# CACHE CONFIG
# =========================
CACHE_ENABLED=true
CACHE_STORE=memory
CACHE_TTL=60
CACHE_MAX=1000

# =========================
# DASHBOARD
# =========================
DASHBOARD_CACHE_ENABLED=true
DASHBOARD_CACHE_TTL_SECONDS=60
DASHBOARD_MAX_RANGE_DAYS=366
DASHBOARD_MAX_DATE_RANGE_DAYS=1095

# =========================
# SAAS BILLING
# =========================
SAAS_BILLING_ENABLED=true
SAAS_BILLING_CYCLE_CRON=0 30 1 * * *
SAAS_INVOICE_DUE_DAYS=14
SAAS_PAST_DUE_GRACE_DAYS=7
SAAS_USAGE_AGGREGATION_CRON=0 15 1 * * *
SAAS_DUNNING_CRON=0 15 1 * * *
SAAS_AUTO_SUSPEND_ENABLED=true
SAAS_AUTO_RESTORE_AFTER_PAYMENT=true

# =========================
# API KEYS / SECURITY / SESSIONS
# =========================
API_KEYS_ENABLED=true
API_KEY_REQUIRE_IP_ALLOWLIST=true
API_KEY_MAX_IPS_PER_KEY=1
API_KEY_DEFAULT_RATE_LIMIT_PER_MINUTE=60
API_KEY_ROTATION_GRACE_HOURS=24
API_KEY_MAX_VALIDITY_DAYS=365
SECURITY_ENCRYPTION_KEY=
SECURITY_ENCRYPTION_KEY_VERSION=1
SECURITY_STEP_UP_ENABLED=true
SECURITY_STEP_UP_MAX_AGE_MINUTES=10
SECURITY_AUDIT_HASH_CHAIN_ENABLED=true
SECURITY_REQUIRE_2FA_FOR_ALL_USERS=false
SECURITY_REQUIRE_2FA_ROLES=ADMINISTRATOR,SUPER_ADMIN
SECURITY_REQUIRE_2FA_PERMISSIONS=security-policies:activate,security-policies:approve
SECURITY_REQUIRE_2FA_USER_TYPES=SUPER_ADMIN,COMPANY_ADMIN
SESSION_IDLE_MINUTES=1440
SESSION_ABSOLUTE_HOURS=24
SESSION_MAX_CONCURRENT=5
SESSION_REFRESH_ROTATION_ENABLED=true
SESSION_REFRESH_REUSE_DETECTION=true
SESSION_REFRESH_ROTATION_GRACE_SECONDS=30
AUDIT_ENABLED=true
AUDIT_HASH_CHAIN_ENABLED=true
AUDIT_SENSITIVE_METADATA_REDACTION=true
DATA_RETENTION_ENABLED=true
DATA_RETENTION_CRON=0 0 2 * * *
DATA_RETENTION_DRY_RUN_DEFAULT=true

# =========================
# OBSERVABILITY / NETWORKING
# =========================
OBSERVABILITY_ENABLED=true
METRICS_ENABLED=true
TRACING_ENABLED=true
HEALTH_DETAILS_PUBLIC=false
SLOW_REQUEST_THRESHOLD_MS=2000
TRUST_PROXY_ENABLED=true
TRUST_PROXY_HOPS=1

# =========================
# REGULATORY COMPLIANCE
# =========================
REGULATORY_ENABLED=true
REGULATORY_CALENDAR_ENABLED=true
REGULATORY_CALENDAR_GENERATION_CRON=0 10 0 * * *
REGULATORY_MONITOR_CRON=0 15 0 * * *
REGULATORY_DUE_MONITOR_CRON=0 * * * *
REGULATORY_MONITOR_BATCH_SIZE=500
REGULATORY_WARNING_DAYS=7
REGULATORY_DEFAULT_TIMEZONE=Africa/Dar_es_Salaam
REGULATORY_RECONCILIATION_TOLERANCE=0.01
REGULATORY_REQUIRE_SUBMISSION_EVIDENCE=true
PREMIUM_LEVY_DEFAULT_RATE=1.5
PREMIUM_LEVY_AUTO_CALCULATE=false
PREMIUM_LEVY_REQUIRE_ADJUSTMENT_EVIDENCE=true

# =========================
# REPORTING
# =========================
REPORTING_ENABLED=true
REPORTING_QUEUE_ENABLED=true
REPORTING_PAGE_SIZE=5000
REPORTING_DEFAULT_MAX_ROWS=100000
REPORTING_HARD_MAX_ROWS=1000000
REPORTING_DEFAULT_RETENTION_DAYS=90
REPORTING_MAX_RETENTION_DAYS=3650
REPORTING_DOWNLOAD_TOKEN_MINUTES=10
REPORTING_SCHEDULE_MONITOR_CRON=* * * * *
REPORTING_DELIVERY_MAX_ATTEMPTS=5
REPORTING_DELIVERY_BASE_DELAY_SECONDS=60
REPORTS_ENABLED=true
REPORTS_SCHEDULER_CRON=0 * * * * *
REPORTS_WORKER_CRON=15 * * * * *
REPORTS_MAX_RETRIES=3
REPORTS_ARTIFACT_RETENTION_DAYS=30
REPORTS_REQUIRE_MAIL_VERIFICATION=true
REPORTS_MAIL_VERIFICATION_VALID_HOURS=24
REPORTS_MAX_ROWS=200000
REPORTS_DEFAULT_TIMEZONE=Africa/Dar_es_Salaam

# =========================
# CORS CONFIG
# =========================
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:9092
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS
CORS_CREDENTIALS=true

# =========================
# LOGGER CONFIG
# Production: LOGGER_LEVEL=error,warn (drop log/debug/verbose to cut noise)
# Also set DB_LOGGING=false in production to silence per-query SQL logs.
# =========================
LOGGER_ENABLED=true
LOGGER_LEVEL=log,error,warn,debug,verbose
LOGGER_PRETTY=true

# =========================
# MAIL CONFIG
# =========================
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=no-reply@example.com
MAIL_PASSWORD=replace-with-smtp-password
MAIL_FROM_NAME=Insurance Portal
MAIL_FROM_EMAIL=no-reply@example.com

# =========================
# QUEUE CONFIG
# =========================
QUEUE_ENABLED=true
QUEUE_PREFIX=insurance-portal-service
QUEUE_DEFAULT_JOB_ATTEMPTS=3
QUEUE_DEFAULT_JOB_DELAY=0
QUEUE_REMOVE_ON_COMPLETE=true
QUEUE_REMOVE_ON_FAIL=false

# =========================
# REDIS CONFIG
# =========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=insurance-portal:
REDIS_RETRY_ATTEMPTS=5
REDIS_RETRY_DELAY=3000
REDIS_OTP_TTL=300
REDIS_SESSION_TTL=86400

# =========================
# ANALYTICS
# =========================
ANALYTICS_ENABLED=true
ANALYTICS_EVENT_CONSUMER_ENABLED=true
ANALYTICS_PROJECTION_BATCH_SIZE=100
ANALYTICS_PROJECTION_MAX_ATTEMPTS=8
ANALYTICS_CURRENT_LAG_SECONDS=300
ANALYTICS_STALE_LAG_SECONDS=3600
ANALYTICS_REBUILD_ENABLED=true
ANALYTICS_FORECAST_ENABLED=true
ANALYTICS_ANOMALY_ENABLED=true
ANALYTICS_ANOMALY_CRON=0 */1 * * *
ANALYTICS_BENCHMARK_MIN_COMPANIES=5

# =========================
# JWT / SECURITY
# =========================
JWT_ACCESS_SECRET=replace-with-at-least-32-character-secret
JWT_REFRESH_SECRET=replace-with-at-least-32-character-secret
JWT_RESET_SECRET=replace-with-at-least-32-character-secret
JWT_ACCESS_EXPIRATION=1d
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=insurance-idp.tz
JWT_AUDIENCE=insurance-platform
ENABLE_EMAIL_VERIFICATION=true
EMAIL_VERIFICATION_EXPIRY_HOURS=24
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
SMS_PROVIDER=beem
# Credentials for the NextSMS provider; leave blank when another provider is used.
NEXTSMS_USERNAME=
NEXTSMS_PASSWORD=
NEXTSMS_SENDER_ID=INFO
NEXTSMS_ENDPOINT=https://messaging.nextsms.co.tz/api/sms/v1/text/single
BEEM_ENDPOINT=https://apisms.beem.africa/v1/send
AT_LIVE_ENDPOINT=https://api.africastalking.com
AT_SANDBOX_ENDPOINT=https://api.sandbox.africastalking.com

# =========================
# AUTHENTICATION SECURITY
# =========================
JWT_2FA_SECRET=replace-with-another-unique-32-character-secret
JWT_2FA_EXPIRATION=5m

AUTH_2FA_MAX_ATTEMPTS=5
AUTH_TRUSTED_DEVICE_DAYS=30
AUTH_ALLOW_TRUSTED_DEVICE_BYPASS=true

# Generate using:
# openssl rand -base64 32
AUTH_SECRET_ENCRYPTION_KEY=UkVQTEFDRS1CRUZPUkUtREVQTE9ZLTMyQllURS1LRVk=

AUTH_BACKUP_CODE_PEPPER=replace-with-at-least-32-random-characters
AUTH_DEVICE_TOKEN_PEPPER=replace-with-at-least-32-random-characters

# =========================
# THROTTLING
# =========================
THROTTLER_TTL=60000
THROTTLER_LIMIT=100

# =========================
# TIRAMIS HTTP CLIENT
# =========================
TIRAMIS_SERVICE_BASE_URL=http://127.0.0.1:9091
TIRAMIS_TARGET_ENV=test
TIRAMIS_HTTP_TIMEOUT_MS=60000
TIRAMIS_SOURCE_SERVICE=insurance-portal-service
# Dedicated key for encrypting stored TIRAMIS service API keys. Falls back to
# JWT_ACCESS_SECRET if unset, but should be a separate secret in real environments.
TIRAMIS_SERVICE_API_KEY_ENCRYPTION_KEY=replace-with-at-least-32-character-secret
# Used only to provision a company's very first per-environment TIRAMIS API key
# when none is configured yet. Must match TIRAMIS_BOOTSTRAP_API_KEY seeded into
# the tiramis service (apps/tiramis/.env, via seed:tiramis:config).
TIRAMIS_BOOTSTRAP_API_KEY=replace-with-generated-tms-key

# =========================
# TIRAMIS STATUS SYNC
# =========================
TIRAMIS_STATUS_SYNC_ENABLED=true
TIRAMIS_STATUS_SYNC_CRON=*/2 * * * *
TIRAMIS_STATUS_SYNC_LIMIT=50
TIRAMIS_STATUS_SYNC_INCLUDE_PAYLOAD=true
TIRAMIS_STATUS_SYNC_MAX_AGE_HOURS=72
TIRAMIS_CALLBACK_OVERDUE_MINUTES=10
INSURANCE_PORTAL_WEBHOOK_URL=http://localhost:9090/api/v1/webhooks/tiramis/notifications

# =========================
# TIRAMIS PORTAL OUTBOX / RECONCILIATION
# =========================
TIRAMIS_PORTAL_OUTBOX_ENABLED=true
TIRAMIS_PORTAL_OUTBOX_BATCH_SIZE=50
TIRAMIS_PORTAL_OUTBOX_MAX_ATTEMPTS=10
TIRAMIS_RECONCILIATION_ENABLED=true
TIRAMIS_RECONCILIATION_CRON=*/5 * * * *
TIRAMIS_RECONCILIATION_BATCH_SIZE=50
TIRAMIS_PORTAL_TRANSPORT_RETRY_ENABLED=false
TIRAMIS_LEGACY_ROUTES_ENABLED=true
TIRAMIS_LEGACY_WEBHOOK_ENABLED=false

# =========================
# TIRAMIS RETRY
# =========================
TIRAMIS_RETRY_ENABLED=true
TIRAMIS_RETRY_CRON=*/3 * * * *
TIRAMIS_RETRY_LIMIT=20
TIRAMIS_RETRY_MAX_ATTEMPTS=5
TIRAMIS_RETRY_BASE_DELAY_SECONDS=60
TIRAMIS_RETRY_LOCK_MINUTES=5
TIRAMIS_RETRY_MAX_DELAY_MINUTES=30
TIRAMIS_RETRY_LOCK_TIMEOUT_MINUTES=15

# =========================
# TIRAMIS AUDIT
# =========================
TIRAMIS_AUDIT_ENABLED=true
TIRAMIS_AUDIT_STORE_PAYLOAD_SNAPSHOT=false
TIRAMIS_AUDIT_MAX_METADATA_SIZE=20000

# =========================
# TIRAMIS NOTIFICATIONS
# =========================
TIRAMIS_NOTIFICATION_ENABLED=true
TIRAMIS_NOTIFICATION_WEBHOOK_ENABLED=false
TIRAMIS_NOTIFICATION_WEBHOOK_URL=
TIRAMIS_NOTIFICATION_WEBHOOK_TOKEN=
TIRAMIS_NOTIFICATION_DEDUPE_MINUTES=30
TIRAMIS_NOTIFICATION_MAX_METADATA_SIZE=20000
TIRAMIS_NOTIFICATION_NOTIFY_FINAL_SUCCESS=false
TIRAMIS_NOTIFICATION_NOTIFY_BUSINESS_SYNC_SUCCESS=false

# =========================
# CUSTOMER / INTERMEDIARY PORTAL
# =========================
DOCUMENT_STORAGE_ROOT=./uploads/documents
DOCUMENT_DEFAULT_MAX_BYTES=10485760
DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png

NOTIFICATION_QUEUE_ENABLED=true

PORTAL_INVITATION_EXPIRY_HOURS=48
PORTAL_SESSION_IDLE_MINUTES=1440

PORTAL_UPLOAD_ROOT=./uploads
PORTAL_UPLOAD_MAX_BYTES=10485760

PORTAL_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png

# =========================
# FINANCE
# =========================
FINANCE_BASE_CURRENCY=TZS
FINANCE_DEFAULT_INVOICE_DUE_DAYS=0
FINANCE_ALLOW_OVERPAYMENT=false
FINANCE_AUTO_RECEIPT_PROVIDER_PAYMENTS=true
FINANCE_AUTO_ALLOCATE_EXACT_INVOICE_REFERENCE=true
FINANCE_RECONCILIATION_AUTO_MATCH_SCORE=90
FINANCE_REFUND_APPROVAL_THRESHOLD=0
FINANCE_RECEIPT_REVERSAL_APPROVAL_THRESHOLD=0
FINANCE_COMMISSION_PAYMENT_APPROVAL_THRESHOLD=0
FINANCE_OUTBOX_ENABLED=true
FINANCE_OUTBOX_CRON=*/1 * * * *
FINANCE_OUTBOX_BATCH_SIZE=100
FINANCE_OUTBOX_MAX_ATTEMPTS=10
FINANCE_PROVIDER_PAYLOAD_RETENTION_DAYS=90
