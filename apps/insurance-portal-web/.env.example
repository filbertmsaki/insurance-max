VITE_APP_NAME=Insurance Portal
VITE_APP_ENV=development
VITE_APP_PORT=9092
VITE_APP_URL=http://localhost:9092
VITE_FRONTEND_URL=http://localhost:9092

# Backend origin; API_BASE_URL is derived from this and VITE_API_PREFIX.
VITE_BACKEND_URL=http://localhost:9090
VITE_API_PREFIX=api/v1

# TIRAMIS HTTP API and browser websocket endpoints.
# The frontend should not call TIRAMIS directly. VITE_TIRAMIS_URL is retained
# temporarily for compatibility and should be removed once the canonical
# integration phase is completed.
VITE_TIRAMIS_URL=http://localhost:9091
VITE_WEBSOCKET_URL=ws://localhost:9090
