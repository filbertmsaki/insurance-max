{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@insurance-max/contracts": ["libs/contracts/src"],
      "@insurance-max/observability": ["libs/observability/src"],
      "@insurance-max/portal-shared": ["libs/portal-shared/src"],
      "@insurance-max/portal-shared/*": ["libs/portal-shared/src/*"],
      "@insurance-max/persistence": ["libs/persistence/src"],
      "@insurance-max/shared-config": ["libs/shared-config/src"],
      "@insurance-max/shared-kernel": ["libs/shared-kernel/src"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  },
  "include": ["apps/**/*.ts", "libs/**/*.ts", "test/**/*.ts"]
}
