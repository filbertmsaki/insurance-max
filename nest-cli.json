{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/tiramis",
  "sourceRoot": "apps/tiramis/src",
  "compilerOptions": {
    "webpack": false,
    "deleteOutDir": true,
    "tsConfigPath": "apps/tiramis/tsconfig.app.json"
  },
  "projects": {
    "tiramis": {
      "type": "application",
      "root": "apps/tiramis",
      "entryFile": "main",
      "sourceRoot": "apps/tiramis/src",
      "compilerOptions": {
        "tsConfigPath": "apps/tiramis/tsconfig.app.json"
      }
    },
    "insurance-portal-service": {
      "type": "application",
      "root": "apps/insurance-portal-service",
      "entryFile": "main",
      "sourceRoot": "apps/insurance-portal-service/src",
      "compilerOptions": {
        "assets": [
          {
            "include": "**/*.pug",
            "outDir": "dist/apps/insurance-portal-service/apps/insurance-portal-service/src"
          },
          {
            "include": "database/seeds/data/*.json",
            "outDir": "dist/apps/insurance-portal-service/apps/insurance-portal-service/src"
          }
        ],
        "watchAssets": true,
        "tsConfigPath": "apps/insurance-portal-service/tsconfig.app.json"
      }
    }
  }
}
