# Copy to /opt/apps/tiramis/shared/.env on the production server.
# Required ownership/permissions:
#   chown alliance:alliance /opt/apps/tiramis/shared/.env
#   chmod 600 /opt/apps/tiramis/shared/.env
#
# This file is loaded by PM2 and symlinked into each release by deploy.sh.

APP_NAME=TIRAMIS Service
APP_ENV=production
NODE_ENV=production
APP_HOST=0.0.0.0
APP_PORT=9090
APP_GLOBAL_PREFIX=api
APP_VERSION=v1
# REQUIRED: public HTTPS base of this service including the proxy prefix,
# without /api, e.g. https://api.example.com/tiramis-api. Leave the line
# commented until known: an empty value fails startup validation.
# APP_URL=
TIRAMIS_TARGET_ENV=live

DB_TYPE=postgres
DB_HOST=replace-with-live-db-host
DB_PORT=5432
DB_USERNAME=replace-with-live-db-user
DB_PASSWORD=
DB_DATABASE=tiramis_db
DB_NAME=tiramis_db
DB_SCHEMA=public
DB_ORACLE_CONNECT_STRING=
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=true

LOGGER_ENABLED=true
LOGGER_LEVEL=log,error,warn

# Generate once and keep stable:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TIRAMIS_SECRET_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# Old key(s), comma separated, still accepted for decryption during a key rotation.
TIRAMIS_SECRET_ENCRYPTION_KEY_PREVIOUS=
TIRAMIS_TRUSTED_PROXY_IPS=127.0.0.1,::1
# Must equal the portal JWT_ACCESS_SECRET; only portal platform admins may call
# TIRAMIS key-management/configuration endpoints.
PORTAL_ADMIN_JWT_ACCESS_SECRET=
PORTAL_ADMIN_JWT_ISSUER=insurance-idp.tz
PORTAL_ADMIN_JWT_AUDIENCE=insurance-platform
PORTAL_ADMIN_SESSION_VALIDATION_ENABLED=false
PORTAL_ADMIN_SESSION_INTROSPECTION_URL=
PORTAL_ADMIN_REQUIRED_PERMISSIONS=
PORTAL_ADMIN_MFA_MAX_AGE_MINUTES=0
PORTAL_ADMIN_RATE_LIMIT_MAX=60
PORTAL_ADMIN_RATE_LIMIT_WINDOW_MS=60000
TIRAMIS_CERTIFICATE_BASE_DIR=/opt/apps/tiramis/certificates
TIRAMIS_CERTIFICATE_EXPIRY_WARNING_DAYS=30

ALLIANCE_TIRA_CLIENT_KEY_TEST=
ALLIANCE_CLIENT_PRIVATE_CERT_PASSWORD_TEST=
TIRA_PUBLIC_CERT_PASSWORD_TEST=
# REQUIRED (an empty value fails startup validation)
# TIRAMIS_TEST_BASE_URL=
# Optional; defaults to APP_URL/api/tiramis/callbacks/test when seeding
# TIRAMIS_TEST_CALLBACK_URL=

ALLIANCE_TIRA_CLIENT_KEY_LIVE=
ALLIANCE_CLIENT_PRIVATE_CERT_PASSWORD_LIVE=
TIRA_PUBLIC_CERT_PASSWORD_LIVE=
# REQUIRED (an empty value fails startup validation)
# TIRAMIS_LIVE_BASE_URL=
# Optional; defaults to APP_URL/api/tiramis/callbacks/live when seeding
# TIRAMIS_LIVE_CALLBACK_URL=
# Set to test to seed only the test configuration while live credentials are pending
# TIRAMIS_SEED_ENVIRONMENTS=test

TIRAMIS_PORTAL_NOTIFY_ENABLED=true
INSURANCE_PORTAL_WEBHOOK_TIMEOUT_MS=5000
TIRAMIS_PORTAL_WEBHOOK_MAX_ATTEMPTS=8
TIRAMIS_PORTAL_WEBHOOK_ALLOWED_HOSTS=
TIRAMIS_PORTAL_WEBHOOK_REQUIRE_HTTPS=true
TIRAMIS_PORTAL_WEBHOOK_BLOCK_PRIVATE_IPS=true
TIRAMIS_PORTAL_WEBHOOK_SIGNING_SECRET=
TIRAMIS_PORTAL_OUTBOX_BATCH_SIZE=20
TIRAMIS_PORTAL_OUTBOX_INTERVAL_MS=10000

TIRAMIS_RETRY_ENABLED=true
TIRAMIS_INTERNAL_CALLBACK_TESTS_ENABLED=false
TIRAMIS_RETRY_BATCH_SIZE=20
TIRAMIS_RETRY_MAX_ATTEMPTS=5
TIRAMIS_RETRY_BASE_DELAY_SECONDS=60
TIRAMIS_RETRY_MAX_DELAY_SECONDS=900
TIRAMIS_FINAL_CALLBACK_TIMEOUT_MINUTES=30

TIRAMIS_HTTP_TIMEOUT_MS=60000
TIRAMIS_LOG_PAYLOADS=false
# Full request/response/callback XML in <RequestId>.log, independent of console payload logging.
TIRAMIS_REQUEST_LOG_ENABLED=true
TIRAMIS_REQUEST_LOG_REDACT_XML=true
TIRAMIS_REQUEST_LOG_REDACTED_XML_TAGS=
TIRAMIS_REQUEST_LOG_DIR=/opt/apps/tiramis/shared/tira-requests
TIRAMIS_CALLBACK_DEAD_LETTER_RAW_XML_MODE=redacted
TIRAMIS_CALLBACK_DIAGNOSTICS_RETENTION_ENABLED=true
TIRAMIS_CALLBACK_DIAGNOSTICS_RETENTION_DAYS=180
TIRAMIS_LEGACY_RAW_API_KEYS_ENABLED=false

# Persists tiramis_callback_error.log across deploys. PM2's cwd
# (/opt/apps/tiramis/current) is a symlink into a per-release directory that
# gets replaced on every deploy, so this must point at the shared dir instead.
TIRAMIS_CALLBACK_ERROR_LOG_DIR=/opt/apps/tiramis/shared

API_DEBUG_ERRORS_ENABLED=false
SLOW_REQUEST_THRESHOLD_MS=2000
