{
  "name": "insurance-max",
  "version": "0.0.1",
  "description": "Deployment-ready NestJS microservice monorepo",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build tiramis",
    "build:insurance-portal-service": "nest build insurance-portal-service",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start tiramis",
    "start:insurance-portal-service": "nest start insurance-portal-service",
    "start:dev": "nest start tiramis --watch",
    "start:dev:insurance-portal-service": "nest start insurance-portal-service --watch",
    "start:debug": "nest start tiramis --debug --watch",
    "start:prod": "node dist/apps/tiramis/main",
    "start:prod:insurance-portal-service": "node dist/apps/insurance-portal-service/apps/insurance-portal-service/src/main",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/tiramis/test/jest-e2e.json",
    "migration:generate:tiramis": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/tiramis/src/database/data-source.ts migration:generate apps/tiramis/src/database/migrations/AutoMigration",
    "migration:run:tiramis": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/tiramis/src/database/data-source.ts migration:run",
    "migration:revert:tiramis": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/tiramis/src/database/data-source.ts migration:revert",
    "seed:tiramis:config": "node -r ts-node/register -r tsconfig-paths/register apps/tiramis/src/database/seeders/seed-tiramis-config.ts",
    "db:prepare:tiramis:e2e": "node -r ts-node/register -r tsconfig-paths/register scripts/prepare-tiramis-e2e.js",
    "pretest:tiramis:e2e": "npm run db:prepare:tiramis:e2e",
    "test:tiramis:e2e": "node scripts/tiramis-e2e-test.js",
    "migration:generate:insurance-portal-service": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/insurance-portal-service/src/database/data-source.ts migration:generate apps/insurance-portal-service/src/database/migrations/Migration",
    "migration:run:insurance-portal-service": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/insurance-portal-service/src/database/data-source.ts migration:run",
    "migration:revert:insurance-portal-service": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/insurance-portal-service/src/database/data-source.ts migration:revert",
    "migration:show:insurance-portal-service": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/insurance-portal-service/src/database/data-source.ts migration:show",
    "seed:insurance-portal-service": "node -r ts-node/register -r tsconfig-paths/register apps/insurance-portal-service/src/database/seeds/run-seed.ts"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/microservices": "^11.1.24",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "argon2": "^0.43.0",
    "axios": "^1.17.0",
    "body-parser": "^2.2.2",
    "bullmq": "^5.78.0",
    "cache-manager": "^7.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "fast-xml-parser": "^5.8.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.0",
    "joi": "^18.2.1",
    "ms": "^2.1.3",
    "mysql2": "^3.22.4",
    "node-forge": "^1.4.0",
    "nodemailer": "^8.0.10",
    "oracledb": "^6.10.0",
    "otplib": "^13.1.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.21.0",
    "pug": "^3.0.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28",
    "typeorm-extension": "^3.7.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/body-parser": "^1.19.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "apps/**/*.ts",
      "libs/**/*.ts"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@insurance-max/contracts$": "<rootDir>/libs/contracts/src",
      "^@insurance-max/observability$": "<rootDir>/libs/observability/src",
      "^@insurance-max/portal-shared$": "<rootDir>/libs/portal-shared/src",
      "^@insurance-max/portal-shared/(.*)$": "<rootDir>/libs/portal-shared/src/$1",
      "^@insurance-max/persistence$": "<rootDir>/libs/persistence/src",
      "^@insurance-max/shared-config$": "<rootDir>/libs/shared-config/src",
      "^@insurance-max/shared-kernel$": "<rootDir>/libs/shared-kernel/src"
    }
  }
}
