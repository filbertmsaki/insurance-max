{
  "name": "insurance-max",
  "version": "0.0.1",
  "description": "Deployment-ready NestJS microservice monorepo",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "nest start tiramis",
    "start:all": "concurrently --kill-others --names tiramis,backend,frontend \"npm run start:dev:tiramis\" \"npm run start:dev:insurance-portal-service\" \"npm run start:dev:insurance-portal-web\"",
    "start:tiramis": "nest start tiramis",
    "start:insurance-portal-service": "node -e \"console.log('[startup] Compiling insurance portal service...')\" && nest start insurance-portal-service",
    "start:dev": "nest start tiramis --watch",
    "start:dev:tiramis": "nest start tiramis --watch",
    "start:dev:insurance-portal-service": "nest start insurance-portal-service --watch",
    "start:dev:insurance-portal-web": "npm --prefix apps/insurance-portal-web run dev",
    "start:prod": "node dist/apps/tiramis/apps/tiramis/src/main.js",
    "start:prod:tiramis": "node dist/apps/tiramis/apps/tiramis/src/main.js",
    "start:prod:insurance-portal-service": "node dist/apps/insurance-portal-service/apps/insurance-portal-service/src/main.js",
    "start:prod:insurance-portal-web": "npm --prefix apps/insurance-portal-web run preview -- --host 0.0.0.0 --port 9092",
    "build": "npm run build:all",
    "build:tiramis": "nest build tiramis",
    "tiramis:api-key:create": "node -r ts-node/register -r tsconfig-paths/register scripts/create-tiramis-api-key.ts",
    "tiramis:api-key:create:production": "node scripts/create-tiramis-api-key.production.js",
    "build:insurance-portal-service": "nest build insurance-portal-service",
    "build:insurance-portal-web": "npm --prefix apps/insurance-portal-web run build",
    "build:all": "npm run build:tiramis && npm run build:insurance-portal-service && npm run build:insurance-portal-web",
    "lint": "npm run lint:backend",
    "lint:backend": "node --max-old-space-size=4096 ./node_modules/eslint/bin/eslint.js \"{apps,libs}/**/*.ts\"",
    "lint:backend:fix": "node --max-old-space-size=4096 ./node_modules/eslint/bin/eslint.js \"{apps,libs}/**/*.ts\" --fix",
    "lint:tiramis": "node --max-old-space-size=4096 ./node_modules/eslint/bin/eslint.js \"apps/tiramis/**/*.ts\"",
    "lint:insurance-portal-service": "node --max-old-space-size=4096 ./node_modules/eslint/bin/eslint.js \"apps/insurance-portal-service/**/*.ts\"",
    "lint:libs": "node --max-old-space-size=4096 ./node_modules/eslint/bin/eslint.js \"libs/**/*.ts\"",
    "lint:web": "npm --prefix apps/insurance-portal-web run lint",
    "lint:all": "npm run lint:tiramis && npm run lint:insurance-portal-service && npm run lint:libs && npm run lint:web",
    "format": "prettier --write \"apps/**/*.{ts,tsx}\" \"libs/**/*.ts\" \"scripts/**/*.{js,mjs,ts}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx}\" \"libs/**/*.ts\" \"scripts/**/*.{js,mjs,ts}\"",
    "test": "npm run test:backend",
    "test:backend": "jest --runInBand --passWithNoTests",
    "test:e2e": "jest --config apps/insurance-portal-service/test/jest-e2e.json --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:web": "npm --prefix apps/insurance-portal-web run test",
    "test:all": "npm run test:backend && npm run test:web",
    "test:policy-endorsement": "jest --runInBand --passWithNoTests apps/insurance-portal-service/src/modules/tenant/issuance apps/insurance-portal-service/src/modules/tenant/policies apps/insurance-portal-service/src/modules/tenant/policy-transactions apps/insurance-portal-service/src/modules/tenant/tiramis-integration",
    "verify:policy-endorsement": "npm run format:check && npm run lint:all && npm run test:policy-endorsement && npm run test:web && npm run build:insurance-portal-service && npm run build:insurance-portal-web",
    "smoke:claims-live": "node scripts/claims-live-smoke.mjs",
    "smoke:underwrite-live": "node scripts/underwrite-live-smoke.mjs",
    "smoke:fleet-issue-live": "node scripts/fleet-issue-live-smoke.mjs",
    "smoke:fleet-endorsements-live": "node scripts/fleet-endorsement-live-smoke.mjs",
    "smoke:non-motor-live": "node scripts/non-motor-live-smoke.mjs",
    "db:backup": "node scripts/db-maintenance.js backup",
    "db:wipe": "node scripts/db-maintenance.js wipe",
    "db:migrate": "node scripts/db-maintenance.js migrate",
    "db:seed": "node scripts/db-maintenance.js seed",
    "db:reset": "node scripts/db-maintenance.js reset",
    "db:backup-reset": "node scripts/db-maintenance.js backup-reset",
    "db:show:tiramis-compliance": "npm run migration:show:tiramis && npm run migration:show:insurance-portal-service",
    "db:apply:tiramis-compliance": "node scripts/apply-tiramis-compliance-db.js",
    "migration:generate:tiramis": "node scripts/typeorm-generate-migration.js --app=tiramis --name=BaselineMigration",
    "migration:run:tiramis": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/tiramis/src/database/data-source.ts migration:run",
    "migration:revert:tiramis": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/tiramis/src/database/data-source.ts migration:revert",
    "migration:show:tiramis": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/tiramis/src/database/data-source.ts migration:show",
    "migration:run:tiramis:production": "node ./node_modules/typeorm/cli.js -d dist/apps/tiramis/apps/tiramis/src/database/data-source.js migration:run",
    "migration:revert:tiramis:production": "node ./node_modules/typeorm/cli.js -d dist/apps/tiramis/apps/tiramis/src/database/data-source.js migration:revert",
    "migration:show:tiramis:production": "node ./node_modules/typeorm/cli.js -d dist/apps/tiramis/apps/tiramis/src/database/data-source.js migration:show",
    "migration:generate:insurance-portal-service": "node scripts/typeorm-generate-migration.js --app=insurance-portal-service --name=BaselineMigration",
    "migration:run:insurance-portal-service": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/insurance-portal-service/src/database/data-source.ts migration:run",
    "migration:revert:insurance-portal-service": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/insurance-portal-service/src/database/data-source.ts migration:revert",
    "migration:show:insurance-portal-service": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/insurance-portal-service/src/database/data-source.ts migration:show",
    "migration:run:insurance-portal-service:production": "node ./node_modules/typeorm/cli.js -d dist/apps/insurance-portal-service/apps/insurance-portal-service/src/database/data-source.js migration:run",
    "migration:revert:insurance-portal-service:production": "node ./node_modules/typeorm/cli.js -d dist/apps/insurance-portal-service/apps/insurance-portal-service/src/database/data-source.js migration:revert",
    "migration:show:insurance-portal-service:production": "node ./node_modules/typeorm/cli.js -d dist/apps/insurance-portal-service/apps/insurance-portal-service/src/database/data-source.js migration:show",
    "seed:tiramis:config": "node -r ts-node/register -r tsconfig-paths/register apps/tiramis/src/database/seeders/seed-tiramis-config.ts",
    "seed:tiramis:config:production": "node dist/apps/tiramis/apps/tiramis/src/database/seeders/seed-tiramis-config.js",
    "seed:insurance-portal-service": "node -r ts-node/register -r tsconfig-paths/register apps/insurance-portal-service/src/database/seeds/run-seed.ts",
    "seed:insurance-portal-service:production": "node dist/apps/insurance-portal-service/apps/insurance-portal-service/src/database/seeds/run-seed.js",
    "tiramis:sync-webhook-keys": "node -r ts-node/register -r tsconfig-paths/register apps/insurance-portal-service/src/database/seeds/scripts/sync-tiramis-webhook-keys.ts"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^2.0.1",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/microservices": "^11.1.24",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "argon2": "^0.43.0",
    "axios": "^1.17.0",
    "body-parser": "^2.2.2",
    "bullmq": "^5.78.0",
    "cache-manager": "^7.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "cron-parser": "^5.7.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.8.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.0",
    "joi": "^18.2.1",
    "luxon": "^3.7.2",
    "ms": "^2.1.3",
    "mysql2": "^3.22.4",
    "node-forge": "^1.4.0",
    "nodemailer": "^9.0.3",
    "oracledb": "^6.10.0",
    "otplib": "^13.1.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.21.0",
    "preview-email": "^3.3.0",
    "pug": "^3.0.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28",
    "typeorm-extension": "^3.7.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/body-parser": "^1.19.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.3",
    "@types/node": "^24.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^7.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "apps/**/*.ts",
      "libs/**/*.ts"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@insurance-max/contracts$": "<rootDir>/libs/contracts/src",
      "^@insurance-max/observability$": "<rootDir>/libs/observability/src",
      "^@insurance-max/portal-shared$": "<rootDir>/libs/portal-shared/src",
      "^@insurance-max/portal-shared/(.*)$": "<rootDir>/libs/portal-shared/src/$1",
      "^@insurance-max/persistence$": "<rootDir>/libs/persistence/src",
      "^@insurance-max/shared-config$": "<rootDir>/libs/shared-config/src",
      "^@insurance-max/shared-kernel$": "<rootDir>/libs/shared-kernel/src",
      "^otplib$": "<rootDir>/test/mocks/otplib.ts"
    }
  },
  "allowScripts": {
    "argon2@0.43.1": true,
    "msgpackr-extract@3.0.4": true,
    "oracledb@6.10.0": true,
    "unrs-resolver@1.12.2": true,
    "@nestjs/core@11.1.24": true,
    "@scarf/scarf@1.4.0": true
  }
}
