# true = mock TIRA verifies your application request signature
VERIFY_INCOMING_SIGNATURE=true

# true = mock TIRA signs acknowledgement and final response using TIRA private PFX
SIGN_RESPONSES=true

# false = do not accept MOCK_SIGNATURE when testing real signature flow
ALLOW_MOCK_SIGNATURE=false

# compact is safer because it removes whitespace between XML tags before signing/verifying
SIGNATURE_XML_MODE=compact

# Mock TIRA verifies request from your application using CLIENT PUBLIC certificate
CLIENT_PUBLIC_CERT_PATH=./certs/client/tiramisclientpublic.pfx
CLIENT_PUBLIC_CERT_PASSWORD=password

# Optional testing helper only. Real signing should be done by your application.
CLIENT_PRIVATE_PFX_PATH=./certs/client/tiramisclientprivate.pfx
CLIENT_PRIVATE_PFX_PASSWORD=password

# Mock TIRA signs response using TIRA PRIVATE certificate
TIRA_PRIVATE_PFX_PATH=./certs/tira/mock-tira-private.pfx
TIRA_PRIVATE_PFX_PASSWORD=password

# Your application verifies mock response using matching TIRA PUBLIC certificate
TIRA_PUBLIC_CERT_PATH=./certs/tira/mock-tira-public.pfx
TIRA_PUBLIC_CERT_PASSWORD=password

CALLBACK_DELAY_MS=3000
